{
  "name": "parawerk",
  "productName": "ParaWerk",
  "version": "0.2.0-alpha.0",
  "description": "Parametric 2D/3D CAD for the desktop: parts, assemblies, standard parts and drawings.",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "ParaWerk contributors",
    "email": "162882733+UJap94@users.noreply.github.com"
  },
  "homepage": "https://github.com/Ujap1994/ParaWerk",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ujap1994/ParaWerk.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/check-licenses.mjs --write && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=e2e",
    "docs:screenshots": "playwright test --project=docs",
    "bench:kernel": "node --experimental-strip-types bench/kernel/run.ts",
    "bench:solver": "node --experimental-strip-types bench/solver/run.ts",
    "bench:render": "playwright test --project=bench",
    "bench:compare": "node --experimental-strip-types bench/compare.ts",
    "icons": "node scripts/build-icons.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "kernel:verify": "node scripts/verify-kernel.mjs",
    "kernel:build": "scripts/build-occt.sh && scripts/build-kernel.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@salusoft89/planegcs": "1.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "i18next": "26.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zustand": "5.0.15"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
